generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
  TECHNICIAN
  CUSTOMER
}

enum PlantStatus {
  ACTIVE
  INACTIVE
  WARNING
  OFFLINE
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(OPERATOR)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  document    String?  @unique
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  users       User[]
  plants      Plant[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Plant {
  id              String       @id @default(cuid())
  name            String
  customerId      String
  customer        Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status          PlantStatus  @default(ACTIVE)
  installedPowerKw Decimal?
  distributor     String?
  consumerUnit    String?
  address         String?
  latitude        Decimal?
  longitude       Decimal?
  inverters       Inverter[]
  readings        MonitoringReading[]
  alerts          Alert[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Inverter {
  id             String              @id @default(cuid())
  plantId        String
  plant          Plant               @relation(fields: [plantId], references: [id], onDelete: Cascade)
  manufacturer   String
  model          String?
  serialNumber   String?
  externalId     String?
  status         String?
  readings       MonitoringReading[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
}

model MonitoringReading {
  id             String    @id @default(cuid())
  plantId        String
  plant          Plant     @relation(fields: [plantId], references: [id], onDelete: Cascade)
  inverterId     String?
  inverter       Inverter? @relation(fields: [inverterId], references: [id], onDelete: Cascade)
  collectedAt    DateTime
  powerKw        Decimal?
  energyTodayKwh Decimal?
  energyMonthKwh Decimal?
  energyTotalKwh Decimal?
  communicationOk Boolean  @default(true)
  rawPayload     Json?
  createdAt      DateTime @default(now())

  @@index([plantId, collectedAt])
  @@index([inverterId, collectedAt])
}

model Alert {
  id          String        @id @default(cuid())
  plantId     String
  plant       Plant         @relation(fields: [plantId], references: [id], onDelete: Cascade)
  severity    AlertSeverity
  status      AlertStatus   @default(OPEN)
  type        String
  title       String
  description String?
  occurredAt  DateTime      @default(now())
  resolvedAt  DateTime?
  createdAt   DateTime      @default(now())

  @@index([plantId, status])
}

model Integration {
  id          String   @id @default(cuid())
  name        String
  provider    String
  enabled     Boolean  @default(true)
  config      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}