{
  "name": "b7-solar-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:e2e": "node --experimental-strip-types --test tests/e2e/*.e2e.ts",
    "e2e:up": "docker compose -f docker-compose.e2e.yml up -d",
    "e2e:down": "docker compose -f docker-compose.e2e.yml down",
    "e2e:migrate": "node scripts/e2e/run.mjs migrate",
    "e2e:seed": "node scripts/e2e/run.mjs seed",
    "e2e:run": "node scripts/e2e/run.mjs test",
    "db:generate": "pnpm --filter @b7/api prisma:generate",
    "db:migrate": "pnpm --filter @b7/api prisma:migrate",
    "db:seed": "pnpm --filter @b7/api prisma:seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0"
  }
}