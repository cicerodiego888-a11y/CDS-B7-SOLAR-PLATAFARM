DATABASE_URL=postgresql://b7:b7_password@localhost:5432/b7_solar
JWT_SECRET=change-this-in-production
JWT_REFRESH_SECRET=change-this-refresh-in-production
API_PORT=3001
WEB_PORT=3000
CORS_ORIGINS=http://localhost:3000
NODE_ENV=development

# AUXSOL — não preencher URL inventada. Deixe vazio até credenciais oficiais.
# Credenciais somente no backend. Nunca no frontend.
AUXSOL_API_BASE_URL=
AUXSOL_APP_ID=
AUXSOL_APP_SECRET=
# Opcional: nome de outra env var que contém o secret (alternativa a AUXSOL_APP_SECRET).
AUXSOL_SECRET_REF=
AUXSOL_API_TIMEOUT_MS=10000
AUXSOL_HTTP_MAX_RETRIES=2
# Margem (ms) para renovar o token antes de expires_in (padrão 60000).
AUXSOL_TOKEN_REFRESH_MARGIN_MS=60000
AUXSOL_MOCK_MODE=false
AUXSOL_ALLOW_MOCK_IN_PRODUCTION=false
AUXSOL_PERSIST_READINGS=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

MONITORING_COLLECTION_ENABLED=true
MONITORING_COLLECTION_INTERVAL_SECONDS=300
MONITORING_COLLECTION_CONCURRENCY=5
MONITORING_NO_READING_THRESHOLD_SECONDS=900
MONITORING_GENERATION_ANOMALY_ENABLED=false
MONITORING_TIMEZONE=America/Sao_Paulo
# Janela máxima para manter um estado observado. Não é o intervalo oficial da AUXSOL.
MONITORING_AVAILABILITY_MAX_GAP_SECONDS=900
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=60000
RATE_LIMIT_ALERT_MAX=60
RATE_LIMIT_ALERT_WINDOW_MS=60000
RATE_LIMIT_COLLECTION_MAX=30
RATE_LIMIT_COLLECTION_WINDOW_MS=60000
MONITORING_COLLECTION_LOCK_TTL_MS=30000
