DATABASE_URL=postgresql://b7:b7_password@localhost:5432/b7_solar
JWT_SECRET=change-this-in-production
JWT_REFRESH_SECRET=change-this-refresh-in-production
API_PORT=3001
WEB_PORT=3000

# AUXSOL — não preencher URL inventada. Deixe vazio até o contrato oficial.
# CLIENT_ID / CLIENT_SECRET / API_KEY não existem aqui: só após documentação oficial.
AUXSOL_API_BASE_URL=
AUXSOL_API_TIMEOUT_MS=10000
AUXSOL_HTTP_MAX_RETRIES=2
AUXSOL_MOCK_MODE=false
AUXSOL_ALLOW_MOCK_IN_PRODUCTION=false
AUXSOL_PERSIST_READINGS=false
AUXSOL_SECRET_REF=

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

MONITORING_COLLECTION_ENABLED=true
MONITORING_COLLECTION_INTERVAL_SECONDS=300
MONITORING_COLLECTION_CONCURRENCY=5
MONITORING_NO_READING_THRESHOLD_SECONDS=900
MONITORING_GENERATION_ANOMALY_ENABLED=false
MONITORING_TIMEZONE=America/Sao_Paulo
# Janela máxima para manter um estado observado. Não é o intervalo oficial da AUXSOL.
MONITORING_AVAILABILITY_MAX_GAP_SECONDS=900
